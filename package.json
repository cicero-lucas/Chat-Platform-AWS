{
  "name": "aws-serverless-chat",
  "version": "1.0.0",
  "private": true,
  "workspaces": ["frontend", "backend"],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=frontend\" \"npm run dev --workspace=backend\"",
    "build": "npm run build --workspace=frontend && npm run build --workspace=backend",
    "test": "npm run test --workspace=backend",
    "lint": "npm run lint --workspace=frontend && npm run lint --workspace=backend",
    "deploy:dev": "npm run deploy:dev --workspace=backend",
    "deploy:prod": "npm run deploy:prod --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
